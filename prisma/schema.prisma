generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  name        String?
  savedEvents SavedEvent[]
}

model Event {
  id          String       @id @default(cuid())

  slug        String       @unique
  title       String

  continent   String
  country     String

  year        Int

  category    String

  summary     String
  story       String

  significance String

  heroImage   String

  savedBy     SavedEvent[]
}

model SavedEvent {
  id        String @id @default(cuid())

  userId    String
  eventId   String

  user      User   @relation(fields: [userId], references: [id])
  event     Event  @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId])
}